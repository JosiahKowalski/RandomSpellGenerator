rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStringList(list, maxLen) {
      return list is list
        && list.size() <= maxLen
        && (list.size() == 0 || (list[0] is string && list[0].size() <= 120));
    }

    function isValidRingSpellEntry(entry) {
      return entry is map
        && entry.keys().hasAll(['id', 'spellName', 'castLevel', 'casterName', 'saveDC', 'attackBonus', 'notes'])
        && entry.keys().hasOnly(['id', 'spellName', 'castLevel', 'casterName', 'saveDC', 'attackBonus', 'notes'])
        && entry.id is string && entry.id.size() > 0 && entry.id.size() <= 80
        && entry.spellName is string && entry.spellName.size() > 0 && entry.spellName.size() <= 120
        && entry.castLevel is int && entry.castLevel >= 1 && entry.castLevel <= 5
        && entry.casterName is string && entry.casterName.size() <= 60
        && entry.saveDC is string && entry.saveDC.size() <= 16
        && entry.attackBonus is string && entry.attackBonus.size() <= 16
        && entry.notes is string && entry.notes.size() <= 200;
    }

    function isValidRingSpells(list) {
      return list is list
        && list.size() <= 5
        && (list.size() == 0 || isValidRingSpellEntry(list[0]));
    }

    function isValidSpellSlots(slots) {
      return slots is map
        && slots.keys().hasAll(['useCustomMax', 'max', 'used', 'bonus'])
        && slots.keys().hasOnly(['useCustomMax', 'max', 'used', 'bonus'])
        && slots.useCustomMax is bool
        && slots.max is map && slots.max.size() <= 9
        && slots.used is map && slots.used.size() <= 9
        && slots.bonus is map && slots.bonus.size() <= 9;
    }

    function isValidSorcery(sorc) {
      return sorc is map
        && sorc.keys().hasAll(['useCustomMax', 'maxPoints', 'usedPoints', 'knownMetamagics'])
        && sorc.keys().hasOnly(['useCustomMax', 'maxPoints', 'usedPoints', 'knownMetamagics'])
        && sorc.useCustomMax is bool
        && sorc.maxPoints is int && sorc.maxPoints >= 0 && sorc.maxPoints <= 30
        && sorc.usedPoints is int && sorc.usedPoints >= 0 && sorc.usedPoints <= 30
        && isValidStringList(sorc.knownMetamagics, 15);
    }

    function isValidConcentrationSpell(val) {
      return val == null || (val is string && val.size() <= 120);
    }

    function isValidRollHistoryEntry(entry) {
      return entry is map
        && entry.keys().hasAll(['id', 'rolledSpellNames', 'rolledAt'])
        && entry.keys().hasOnly(['id', 'rolledSpellNames', 'rolledAt'])
        && entry.id is string && entry.id.size() > 0 && entry.id.size() <= 80
        && isValidStringList(entry.rolledSpellNames, 100)
        && entry.rolledAt is string && entry.rolledAt.size() > 0 && entry.rolledAt.size() <= 40;
    }

    function isValidRollHistory(list) {
      return list is list
        && list.size() <= 8
        && (list.size() == 0 || isValidRollHistoryEntry(list[0]));
    }

    function isValidConfig(cfg) {
      return cfg is map
        && cfg.keys().hasAll([
          'casterLevel',
          'maxSpellLevel',
          'canRitualCast',
          'levelCounts',
          'classWeights',
          'multiClassRule',
          'includeOptionalClasses',
          'schoolWeights',
          'excludeWeaponComponents',
          'excludeCostlyMaterials',
          'excludeConcentration',
          'excludeRituals',
          'excludedSources',
          'activePreset'
        ])
        && cfg.keys().hasOnly([
          'casterLevel',
          'maxSpellLevel',
          'canRitualCast',
          'levelCounts',
          'classWeights',
          'multiClassRule',
          'includeOptionalClasses',
          'schoolWeights',
          'excludeWeaponComponents',
          'excludeCostlyMaterials',
          'excludeConcentration',
          'excludeRituals',
          'excludedSources',
          'activePreset'
        ])
        && cfg.casterLevel is int && cfg.casterLevel >= 1 && cfg.casterLevel <= 20
        && cfg.maxSpellLevel is int && cfg.maxSpellLevel >= 0 && cfg.maxSpellLevel <= 9
        && cfg.canRitualCast is bool
        && cfg.levelCounts is map && cfg.levelCounts.size() <= 10
        && cfg.classWeights is map && cfg.classWeights.size() <= 20
        && cfg.multiClassRule is string && cfg.multiClassRule in ['lowest', 'average', 'highest']
        && cfg.includeOptionalClasses is bool
        && cfg.schoolWeights is map && cfg.schoolWeights.size() <= 15
        && cfg.excludeWeaponComponents is bool
        && cfg.excludeCostlyMaterials is bool
        && cfg.excludeConcentration is bool
        && cfg.excludeRituals is bool
        && isValidStringList(cfg.excludedSources, 100)
        && cfg.activePreset is string && cfg.activePreset.size() <= 40;
    }

    function isValidGrimoireSave(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'knownSpellNames',
          'rolledSpellNames',
          'ringSpells',
          'spellSlots',
          'sorcery',
          'concentrationSpell',
          'rollHistory',
          'config',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'knownSpellNames',
          'rolledSpellNames',
          'ringSpells',
          'spellSlots',
          'sorcery',
          'concentrationSpell',
          'rollHistory',
          'config',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidStringList(data.knownSpellNames, 400)
        && isValidStringList(data.rolledSpellNames, 100)
        && isValidRingSpells(data.ringSpells)
        && isValidSpellSlots(data.spellSlots)
        && isValidSorcery(data.sorcery)
        && isValidConcentrationSpell(data.concentrationSpell)
        && isValidRollHistory(data.rollHistory)
        && isValidConfig(data.config)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Legacy character sheet data (preserved owner-only for reference & migration import)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().keys().hasOnly(['character', 'database', 'activeSpells', 'permanentSpellNames', 'settings']);
      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['character', 'database', 'activeSpells', 'permanentSpellNames', 'settings']);
      allow delete: if false;
    }

    // Dedicated compact spell randomizer save per authenticated user
    match /grimoireSaves/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidGrimoireSave(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidGrimoireSave(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'knownSpellNames',
          'rolledSpellNames',
          'ringSpells',
          'spellSlots',
          'sorcery',
          'concentrationSpell',
          'rollHistory',
          'config',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
